<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.aindriub</groupId>
  <artifactId>jresolve</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>jresolve</name>
  <description>
    Probabilistic entity resolution for Java 8: match a source object against
    candidate objects on fuzzy field evidence and return a ranked, explainable
    decision. No framework, JSON, database or logging dependency.
  </description>
  <url>https://github.com/AindriuB/jresolve</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>AindriuB</id>
      <name>Aindriu Bannister</name>
      <url>https://github.com/AindriuB</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/AindriuB/jresolve.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/AindriuB/jresolve.git</developerConnection>
    <url>https://github.com/AindriuB/jresolve</url>
  </scm>

  <modules>
    <module>jresolve-core</module>
    <module>jresolve-profiles-ie</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>8</maven.compiler.release>
    <toolchain.jdk.version>17</toolchain.jdk.version>

    <junit.version>5.10.2</junit.version>
    <assertj.version>3.25.3</assertj.version>

    <maven-toolchains-plugin.version>3.1.0</maven-toolchains-plugin.version>
    <maven-enforcer-plugin.version>3.4.1</maven-enforcer-plugin.version>
    <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>
    <animal-sniffer-maven-plugin.version>1.23</animal-sniffer-maven-plugin.version>
    <maven-javadoc-plugin.version>3.6.3</maven-javadoc-plugin.version>
    <maven-source-plugin.version>3.3.1</maven-source-plugin.version>
    <maven-gpg-plugin.version>3.2.4</maven-gpg-plugin.version>
    <central-publishing-maven-plugin.version>0.5.0</central-publishing-maven-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
          <configuration>
            <includes>
              <include>**/*Test.java</include>
            </includes>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>animal-sniffer-maven-plugin</artifactId>
          <version>${animal-sniffer-maven-plugin.version}</version>
          <configuration>
            <signature>
              <groupId>org.codehaus.mojo.signature</groupId>
              <artifactId>java18</artifactId>
              <version>1.0</version>
            </signature>
            <skip>false</skip>
          </configuration>
          <executions>
            <execution>
              <id>animal-sniffer-check</id>
              <phase>verify</phase>
              <goals>
                <goal>check</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-toolchains-plugin</artifactId>
        <version>${maven-toolchains-plugin.version}</version>
        <executions>
          <execution>
            <id>toolchain</id>
            <goals>
              <goal>toolchain</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <toolchains>
            <jdk>
              <version>${toolchain.jdk.version}</version>
            </jdk>
          </toolchains>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven-enforcer-plugin.version}</version>
        <executions>
          <execution>
            <id>enforce-build-jdk</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[9,)</version>
                  <message>
                    jresolve is built with the JDK 17 toolchain pinned by maven-toolchains-plugin.
                    Maven itself must run on JDK 9 or newer (JDK 25 or JDK 17 are both fine) because
                    the `--release` flag used to compile to Java 8 does not exist before JDK 9.
                    Building directly on JDK 8 is unsupported.
                  </message>
                </requireJavaVersion>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>animal-sniffer-maven-plugin</artifactId>
      </plugin>
      <!--
        Central rejects a bundle without a sources jar and a javadoc jar. Both
        are built on every run rather than only on release, so a packaging
        problem surfaces on an ordinary build instead of on release day.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>${maven-source-plugin.version}</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals>
              <goal>jar-no-fork</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!--
        A reference that has gone stale fails the build rather than rotting in
        a comment. Task 27 renamed two fixture types and left a neighbouring
        file's Javadoc describing types that no longer existed; nothing caught
        it. doclint does, for anything named with {@link}.

        What it does NOT catch is the defect that raised this gap: a comment
        that describes neighbouring code wrongly while naming nothing. That
        stays a review matter and is recorded as such in PLAN.md.

        This is a build plugin, not a library dependency. Nothing here reaches
        the artifact's classpath, so docs/architecture.md's no-dependency
        boundary is untouched.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>${maven-javadoc-plugin.version}</version>
        <executions>
          <execution>
            <!--
              Test sources need their own execution: javadoc-no-fork reads
              main sources only. The defect that raised this gap lived in a
              test class's Javadoc, so a gate that skipped src/test would have
              been a gate over the wrong half of the repository.
            -->
            <id>javadoc-doclint-tests</id>
            <phase>verify</phase>
            <goals>
              <goal>test-javadoc-no-fork</goal>
            </goals>
            <configuration>
              <show>private</show>
              <doclint>all,-missing</doclint>
              <failOnWarnings>true</failOnWarnings>
              <quiet>true</quiet>
            </configuration>
          </execution>
          <execution>
            <!--
              The javadoc JAR Central requires. Separate from the doclint
              executions above: this one packages, those two gate. Breaking
              either would be a silent loss of the stale-reference check.
            -->
            <id>attach-javadocs</id>
            <goals>
              <goal>jar</goal>
            </goals>
            <configuration>
              <doclint>all,-missing</doclint>
              <quiet>true</quiet>
            </configuration>
          </execution>
          <execution>
            <id>javadoc-doclint</id>
            <phase>verify</phase>
            <goals>
              <goal>javadoc-no-fork</goal>
            </goals>
            <configuration>
              <!--
                private: javadoc's default scope is `protected`, so a stale
                link on a private member is not even looked at. The defect
                this gate exists for does not care which member carries it.
              -->
              <show>private</show>
              <!--
                all,-missing: every doclint group except the one that demands
                complete Javadoc. `reference` is the group this gate exists
                for: a {@link} to something that no longer exists. `missing`
                would add 100 warnings about absent @param and @return tags,
                which is a documentation-completeness policy this project has
                never adopted and is not what a stale reference is.
              -->
              <doclint>all,-missing</doclint>
              <failOnWarnings>true</failOnWarnings>
              <quiet>true</quiet>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Signing and publishing live here and nowhere else, so an ordinary
      `mvn clean verify` never invokes GPG, never needs a key and never slows
      down. Activate with `-Prelease`.

      No credentials are in this repository and none should be. The GPG key
      and the Central token come from the developer's own ~/.m2/settings.xml,
      or from CI secrets; the server id below is a reference to an entry
      there, not a secret itself.

      NOTE: this profile makes publishing POSSIBLE, not PERMITTED. D19 makes a
      licensed alias corpus a release gate, and jresolve-profiles-ie still
      ships hand-written illustrative tables. Nothing publishes until that is
      replaced; see task 28 in docs/plan/PLAN.md.
    -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>${maven-gpg-plugin.version}</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>${central-publishing-maven-plugin.version}</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <!--
                Deliberately not automatic. A release is reviewed in the
                Central portal and released by hand, because the gate above is
                a judgement no plugin can make.
              -->
              <autoPublish>false</autoPublish>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
