<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.aindriub</groupId>
    <artifactId>jresolve</artifactId>
    <version>0.2.0-SNAPSHOT</version>
  </parent>

  <artifactId>jresolve-profiles-ie</artifactId>

  <name>jresolve-profiles-ie</name>
  <description>
    Irish domain profile for jresolve: name and address pipelines, and illustrative alias tables. Optional, and separate from the engine so that core carries no domain vocabulary.
  </description>
  <url>https://github.com/AindriuB/jresolve</url>
  <packaging>jar</packaging>

  <properties>
    <!-- D19: "illustrative" until task 28 replaces the tables with a sourced corpus. -->
    <jresolve.aliasCorpus>illustrative</jresolve.aliasCorpus>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.aindriub</groupId>
      <artifactId>jresolve-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <profiles>
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <executions>
              <execution>
                <id>enforce-alias-corpus-sourced</id>
                <phase>validate</phase>
                <goals>
                  <goal>enforce</goal>
                </goals>
                <configuration>
                  <rules>
                    <requireProperty>
                      <property>jresolve.aliasCorpus</property>
                      <regex>sourced</regex>
                      <regexMessage>D19 release gate: jresolve-profiles-ie still ships illustrative alias tables (jresolve.aliasCorpus must be "sourced", see task 28). Do not release it. Release core only, with: mvn -Prelease -pl jresolve-core -am clean deploy</regexMessage>
                    </requireProperty>
                  </rules>
                  <fail>true</fail>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
